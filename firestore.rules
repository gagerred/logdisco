rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Audição: formato de data e hora, e o álbum precisa existir na coleção do próprio usuário.
    function audicaoValida(uid, d) {
      return d.releaseId is string
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')
        && d.listenedAt is timestamp
        && exists(/databases/$(database)/documents/users/$(uid)/releases/$(d.releaseId));
    }

    // Tudo fica dentro de /users/{uid}: cada usuário só enxerga o próprio ramo.
    match /users/{uid} {
      allow read, create, update: if dono(uid);
      allow delete: if false;

      // Álbuns: dados do Discogs são gravados só pelo servidor.
      // O usuário pode alterar apenas título personalizado e categoria de mídia.
      match /releases/{id} {
        allow read: if dono(uid);
        allow update: if dono(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['titleCustom', 'mediaType', 'updatedAt'])
          && request.resource.data.mediaType in ['CD', 'Vinyl', 'DVD', 'CD/DVD'];
        allow create, delete: if false;
      }

      // Artistas: gravados pelo servidor.
      match /artists/{id} {
        allow read: if dono(uid);
        allow write: if false;
      }

      // Audições: o usuário registra, edita e exclui.
      match /listens/{id} {
        allow read, delete: if dono(uid);
        allow create: if dono(uid) && audicaoValida(uid, request.resource.data);
        // Editar muda só data e horário: a audição não pode passar para outro álbum.
        allow update: if dono(uid) && audicaoValida(uid, request.resource.data)
          && request.resource.data.releaseId == resource.data.releaseId;
      }

      // Quero Conhecer: criado pelo servidor (consulta o Discogs); o usuário pode excluir.
      match /discover/{id} {
        allow read, delete: if dono(uid);
        allow create, update: if false;
      }

      // Gravados só pelo servidor; o usuário apenas lê.
      match /wantlist/{id}      { allow read: if dono(uid); allow write: if false; }
      match /syncRuns/{id}      { allow read: if dono(uid); allow write: if false; }
      match /wantlistRuns/{id}  { allow read: if dono(uid); allow write: if false; }

      // Histórico de alterações: o usuário lê e cria, nunca edita nem apaga.
      match /changeLog/{id} {
        allow read, create: if dono(uid);
        allow update, delete: if false;
      }

      // Estado da integração com o Discogs (usuário, data): o usuário só lê.
      match /integrations/{id} { allow read: if dono(uid); allow write: if false; }

      // Tokens do Discogs e travas de execução: inacessíveis pelo navegador.
      match /private/{id} { allow read, write: if false; }
      match /locks/{id}   { allow read, write: if false; }
    }
  }
}
