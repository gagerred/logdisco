# --- Firebase (navegador): valores do firebaseConfig do app Web ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (servidor): do JSON da chave de conta de serviço ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# No .env.local use aspas duplas; no painel do Vercel cole sem aspas
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Discogs (usados a partir da Etapa 3) ---
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_USER_AGENT="LogDisco/1.0"

# --- Tarefas agendadas (usado a partir da Etapa 7): openssl rand -hex 32 ---
CRON_SECRET=
